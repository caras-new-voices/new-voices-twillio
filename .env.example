# ---------------------------------------------------------------------------
# Server-side environment for the dialer.
#
# The dialer takes its Twilio credentials from the END USER, pasted into the
# web app and kept ONLY in their browser (localStorage). They are never sent
# to or stored on the server, so the server needs essentially nothing.
#
# Copy to `.env.local` for local dev if you need any of the optional vars:
#     cp .env.example .env.local
# ---------------------------------------------------------------------------

# OPTIONAL fallback caller ID for /api/voice. Normally the browser supplies the
# caller ID with each call, so this is not required.
# TWILIO_CALLER_ID=+19729475590

# OPTIONAL: enable Twilio request-signature validation on /api/voice.
# Requires TWILIO_AUTH_TOKEN. Leave off unless you need it.
# TWILIO_VALIDATE_SIGNATURE=true
# TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# The variables below are ONLY used by scripts/setup-twilio.mjs if you choose
# to auto-provision the API Key + TwiML App from a machine that can reach
# api.twilio.com. They are NOT needed by the running app.
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
