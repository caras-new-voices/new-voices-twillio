# ---------------------------------------------------------------------------
# Twilio credentials for the browser dialer.
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# then fill in the real values. NEVER commit .env.local (it is git-ignored).
#
# On Vercel, add each of these under:
#     Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# Account SID — from Twilio Console → Account Info (starts with AC...)
TWILIO_ACCOUNT_SID=

# Auth Token — from Twilio Console → Account Info.
# Only used by scripts/setup-twilio.mjs to provision resources; the running
# app does NOT need it. Prefer an API Key/Secret for everything else.
TWILIO_AUTH_TOKEN=

# API Key SID + Secret — create in Console → Account → API keys & tokens,
# or run `npm run setup:twilio` to create one automatically.
# These SIGN the browser access tokens. The secret is shown only once.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# TwiML App SID — the app whose Voice URL points at /api/voice on your
# deployment. Created automatically by `npm run setup:twilio`.
TWILIO_TWIML_APP_SID=

# The Twilio phone number used as the outbound caller ID (E.164 format).
# For this project use the dev/test number ONLY:
TWILIO_CALLER_ID=+19729475590

# Client identity registered for the browser. Any string; used so inbound
# calls can be routed to this browser via <Dial><Client>.
TWILIO_CLIENT_IDENTITY=new_voices_dialer
